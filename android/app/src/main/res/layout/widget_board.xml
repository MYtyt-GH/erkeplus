<?xml version="1.0" encoding="utf-8"?>
<!--
    课程看板：一天，一行一节课——左边时间、中间课名（大字）、右边教室。
    顶部一行写周次与日期，页脚左边今天的状态、右边「还有 N 节」。
    示例行只用于添加前的预览，真正的内容由 BoardWidgetProvider 整块替换。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 背景：运行时按用户选的颜色/透明度画一张圆角位图 -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/board_week"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_accent"
                android:textSize="12sp"
                android:text="第 11 周" />

            <TextView
                android:id="@+id/board_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:text="11/13 周五" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/board_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <include layout="@layout/widget_board_row" />

            <include layout="@layout/widget_board_row" />

            <include layout="@layout/widget_board_row" />
        </LinearLayout>

        <TextView
            android:id="@+id/board_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp"
            android:visibility="gone"
            android:text="还有 2 节" />

        <TextView
            android:id="@+id/board_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
